# Load these into the process explicitly; the library never auto-loads .env.
CONTEXT_BUDGET_TOKENS=3000
MODEL_CONTEXT_TOKENS=131072
MAX_COMPLETION_TOKENS=256
RETRIEVAL_RESERVE_TOKENS=280
SUMMARY_RESERVE_TOKENS=80
TOKENIZER_NAME=o200k_harmony
TOKENIZER_FUDGE=1.07
ADAPTER_OVERHEAD_TOKENS=0
CAP_MAX_TOKENS=35
CAP_HEAD_TOKENS=22
CAP_TAIL_TOKENS=8
RETRIEVAL_CHUNK_CHARACTERS=360
RETRIEVAL_OVERLAP_CHARACTERS=80
RETRIEVAL_TOP_K=4
RETRIEVAL_MINIMUM_SCORE=0.0
BM25_K1=1.5
BM25_B=0.75
# Optional per-request INPUT cap, not TPM or TPD:
# PROVIDER_INPUT_CAP_TOKENS=8000
# Optional absolute output directory; relative paths resolve from config.py.
# CONTEXT_OUTPUT_DIR=/absolute/path/to/output
# Read only by explicitly authorized provider-probe; never auto-loaded:
GROQ_API_KEY=
# Model selection for provider-probe uses --model; these are roadmap examples:
CHAT_MODEL=openai/gpt-oss-120b
SWAP_MODEL=openai/gpt-oss-20b
